<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="3.1.0-02" author="architect" context="3.1.0">
        <comment>Тип списка листа: SIMPLE (строки) или COMPLEX (заголовок/описание/уровень)</comment>
        <addColumn tableName="rpg_character_attributes">
            <column name="list_kind" type="VARCHAR(16)" defaultValue="SIMPLE">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <addColumn tableName="rpg_custom_attributes">
            <column name="list_kind" type="VARCHAR(16)" defaultValue="SIMPLE">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <comment>
            Существующие листы: list_kind оставляем SIMPLE, реальный формат
            (массив строк или массив объектов) определяется при чтении по JSON,
            поэтому миграция обратно совместима.
        </comment>
    </changeSet>
</databaseChangeLog>
