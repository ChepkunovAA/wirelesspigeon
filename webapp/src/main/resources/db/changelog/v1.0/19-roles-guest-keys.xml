<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="19" author="corpsman">
        <update tableName="users">
            <column name="role" value="MASTER"/>
            <where>role = 'ADMIN'</where>
        </update>
        <update tableName="users">
            <column name="role" value="RESIDENT"/>
            <where>role = 'USER'</where>
        </update>
        <addColumn tableName="invite_tokens">
            <column name="guest_key" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
