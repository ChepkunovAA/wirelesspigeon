<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="16" author="corpsman">
        <addColumn tableName="forum_topics">
            <column name="visibility" type="VARCHAR(20)" defaultValue="OPEN">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <update tableName="forum_topics">
            <column name="visibility" value="PUBLIC"/>
            <where>public_post = true</where>
        </update>
        <dropColumn tableName="forum_topics" columnName="public_post"/>

        <addColumn tableName="forum_posts">
            <column name="is_op" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_continuation" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <sql>
            INSERT INTO forum_posts (content, author_id, is_anonymous, is_deleted, likes, dislikes,
                                     topic_id, is_edited, is_op, is_continuation, version, created_at, updated_at)
            SELECT t.content, t.author_id, t.is_anonymous, false, 0, 0,
                   t.id, false, TRUE, FALSE, 0,
                   COALESCE(t.created_at, NOW()), NOW()
            FROM forum_topics t
            WHERE NOT EXISTS (SELECT 1 FROM forum_posts p WHERE p.topic_id = t.id AND p.is_op = true)
              AND t.is_deleted = false
        </sql>

        <createTable tableName="forum_topic_whitelist">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="topic_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0"/>
        </createTable>
        <addUniqueConstraint tableName="forum_topic_whitelist"
                             columnNames="topic_id, user_id"
                             constraintName="uk_topic_whitelist_unique"/>
        <addForeignKeyConstraint baseTableName="forum_topic_whitelist"
                                 baseColumnNames="topic_id"
                                 referencedTableName="forum_topics"
                                 referencedColumnNames="id"
                                 constraintName="fk_topic_whitelist_topic"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="forum_topic_whitelist"
                                 baseColumnNames="user_id"
                                 referencedTableName="users"
                                 referencedColumnNames="id"
                                 constraintName="fk_topic_whitelist_users"
                                 onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
