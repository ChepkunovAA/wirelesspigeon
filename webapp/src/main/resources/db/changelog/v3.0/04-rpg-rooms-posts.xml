<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="v3.0-04" author="architect">
        <createTable tableName="rpg_room">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="game_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="is_private" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0"/>
        </createTable>
        <createIndex tableName="rpg_room" indexName="idx_rpg_room_game">
            <column name="game_id"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="rpg_room"
                                 baseColumnNames="game_id"
                                 referencedTableName="rpg_games"
                                 referencedColumnNames="id"
                                 constraintName="fk_rpg_room_game"
                                 onDelete="CASCADE"/>

        <createTable tableName="rpg_room_members">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="room_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0"/>
        </createTable>
        <addUniqueConstraint tableName="rpg_room_members"
                             columnNames="room_id, user_id"
                             constraintName="uk_rpg_room_member"/>
        <addForeignKeyConstraint baseTableName="rpg_room_members"
                                 baseColumnNames="room_id"
                                 referencedTableName="rpg_room"
                                 referencedColumnNames="id"
                                 constraintName="fk_rpg_room_member_room"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="rpg_room_members"
                                 baseColumnNames="user_id"
                                 referencedTableName="users"
                                 referencedColumnNames="id"
                                 constraintName="fk_rpg_room_member_user"
                                 onDelete="CASCADE"/>

        <createTable tableName="rpg_room_posts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="room_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="author_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="VARCHAR(1000000)">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0"/>
        </createTable>
        <createIndex tableName="rpg_room_posts" indexName="idx_rpg_posts_room_time">
            <column name="room_id"/>
            <column name="created_at"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="rpg_room_posts"
                                 baseColumnNames="room_id"
                                 referencedTableName="rpg_room"
                                 referencedColumnNames="id"
                                 constraintName="fk_rpg_posts_room"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="rpg_room_posts"
                                 baseColumnNames="author_id"
                                 referencedTableName="users"
                                 referencedColumnNames="id"
                                 constraintName="fk_rpg_posts_author"
                                 onDelete="CASCADE"/>

        <createTable tableName="rpg_dice_rolls">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="post_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="die_size" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="count" type="INTEGER" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="modifier" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="VARCHAR(500)"/>
            <column name="results" type="VARCHAR(1000000)"/>
            <column name="total" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0"/>
        </createTable>
        <createIndex tableName="rpg_dice_rolls" indexName="idx_rpg_rolls_post">
            <column name="post_id"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="rpg_dice_rolls"
                                 baseColumnNames="post_id"
                                 referencedTableName="rpg_room_posts"
                                 referencedColumnNames="id"
                                 constraintName="fk_rpg_rolls_post"
                                 onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>