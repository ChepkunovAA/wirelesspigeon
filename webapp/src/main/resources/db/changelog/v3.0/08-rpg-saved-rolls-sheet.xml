<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Избранные броски мастера привязываются к листу NPC (вложенное «Избранное»
         конкретного NPC). Верхний уровень (sheet_id IS NULL) — личное «Избранное». -->
    <changeSet id="v3.0-11" author="architect">
        <addColumn tableName="rpg_saved_rolls">
            <column name="sheet_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <addForeignKeyConstraint baseTableName="rpg_saved_rolls"
                                 baseColumnNames="sheet_id"
                                 referencedTableName="rpg_character_sheets"
                                 referencedColumnNames="id"
                                 constraintName="fk_rpg_saved_rolls_sheet"
                                 onDelete="CASCADE"/>
        <createIndex tableName="rpg_saved_rolls"
                     indexName="idx_rpg_saved_rolls_user_game_sheet">
            <column name="user_id"/>
            <column name="game_id"/>
            <column name="sheet_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>